@prefix gt: <https://github.com/djshaji/gnuitar#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pg: <http://lv2plug.in/ns/ext/port-groups#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

gt:stereo-input
    a pg:InputGroup , pg:StereoGroup ;
    lv2:symbol "stereo_in" .

gt:stereo-output
    a pg:OutputGroup , pg:StereoGroup ;
    lv2:symbol "stereo_out" .

gt:digital-amp-mono
    a lv2:Plugin , lv2:AmplifierPlugin ;
    doap:name "GNUitar Digital Amp (Mono)" ;
    doap:license <COPYING> ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    lv2:port
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Input"
    ],
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Output"
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "gain_db" ;
        lv2:name "Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 30.0 ;
        units:unit units:db
    ] .

gt:digital-amp-stereo
    a lv2:Plugin , lv2:AmplifierPlugin ;
    doap:name "GNUitar Digital Amp (Stereo)" ;
    doap:license <COPYING> ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    pg:mainInput gt:stereo-input ;
    pg:mainOutput gt:stereo-output ;
    lv2:port
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Input Left" ;
        pg:group gt:stereo-input ;
        lv2:designation pg:left
    ],
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Input Right" ;
        pg:group gt:stereo-input ;
        lv2:designation pg:right
    ],
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Output Left" ;
        pg:group gt:stereo-output ;
        lv2:designation pg:left
    ],
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Output Right" ;
        pg:group gt:stereo-output ;
        lv2:designation pg:right
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "gain_db" ;
        lv2:name "Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 30.0 ;
        units:unit units:db
    ] .

gt:tremolo-mono
    a lv2:Plugin , lv2:ModulatorPlugin ;
    doap:name "GNUitar Tremolo (Mono)" ;
    doap:license <COPYING> ;
